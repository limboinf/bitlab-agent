{
  "name": "@bitlab/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Terminal client for Bitlab server",
  "type": "module",
  "main": "dist/bitlab",
  "files": [
    "dist/bitlab"
  ],
  "bin": {
    "bitlab": "dist/bitlab"
  },
  "scripts": {
    "build": "mkdir -p dist && bun build src/index.ts --target=bun --outfile=dist/bitlab",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/"
  },
  "dependencies": {
    "@bitlab/shared": "workspace:*",
    "@bitlab/server-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "@types/bun": "latest"
  }
}
